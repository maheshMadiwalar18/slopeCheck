{
  "name": "@slopcheck/benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluation and benchmarking harness for Slopcheck Agent",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "pnpm dlx tsx src/index.ts",
    "start:live": "pnpm dlx tsx src/index.ts --live",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slopcheck/core": "workspace:*",
    "slopcheck-agent": "workspace:*",
    "@slopcheck/registry": "workspace:*",
    "picocolors": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@slopcheck/config": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
