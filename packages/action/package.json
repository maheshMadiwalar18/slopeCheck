{
  "name": "@slopcheck/action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action for Slopcheck Agent",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --no-splitting",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1"
  },
  "devDependencies": {
    "@slopcheck/config": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
