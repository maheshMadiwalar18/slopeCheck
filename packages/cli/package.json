{
  "name": "slopcheck-agent",
  "version": "0.1.0",
  "description": "Slopcheck: Security analysis and risk scoring for npm packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maheshMadiwalar18/slopeCheck.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/maheshMadiwalar18/slopeCheck/issues"
  },
  "homepage": "https://github.com/maheshMadiwalar18/slopeCheck#readme",
  "keywords": [
    "security",
    "npm",
    "supply-chain",
    "hallucination",
    "typosquatting",
    "ai"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "slopcheck-agent": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && node -e \"require('fs').cpSync('../datasets/data', './data', {recursive: true})\" && node -e \"require('fs').cpSync('../../README.md', './README.md')\" && node -e \"require('fs').cpSync('../../LICENSE', './LICENSE')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "cli-progress": "^3.12.0",
    "js-yaml": "^5.3.0",
    "p-limit": "^7.3.1",
    "picocolors": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@slopcheck/config": "workspace:*",
    "@slopcheck/core": "workspace:*",
    "@slopcheck/datasets": "workspace:*",
    "@slopcheck/heuristics": "workspace:*",
    "@slopcheck/registry": "workspace:*",
    "@types/cli-progress": "^3.11.6",
    "@types/js-yaml": "^4.0.9",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
